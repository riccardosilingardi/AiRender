# Variabili del sito Netlify (Site configuration > Environment variables).
# Qui solo i nomi: i valori stanno in Netlify, mai nel repository.

# Comfy Router: la chiave di Riccardo. I clienti non la vedono mai.
COMFY_API_KEY=

# Supabase (Project settings > API): URL e chiave service_role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys e Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Id dei prezzi creati nel catalogo prodotti di Stripe (price_...).
STRIPE_PREZZO_PROVA=
STRIPE_PREZZO_RICARICA=
STRIPE_PREZZO_BASE_MESE=
STRIPE_PREZZO_BASE_ANNO=
STRIPE_PREZZO_PRO_MESE=
STRIPE_PREZZO_PRO_ANNO=
STRIPE_PREZZO_STUDIO_MESE=
STRIPE_PREZZO_STUDIO_ANNO=
# Facoltativa: aliquota IVA 22% (Tax rates, txr_...). Vuota: nessuna IVA aggiunta.
STRIPE_ALIQUOTA_IVA=

# Fatture in Cloud (Impostazioni > Connessioni > token personale). Vuoto FIC_TOKEN: niente fatture.
FIC_TOKEN=
FIC_ID_AZIENDA=
FIC_ID_IVA=
FIC_ID_CONTO=
# "si" per mandare allo SdI in automatico. Per le prime fatture lascialo vuoto e controllale nel cruscotto.
FIC_INVIA_SDI=

# Email col codice licenza (resend.com).
RESEND_API_KEY=
EMAIL_MITTENTE=

# Indirizzo pubblico del sito, senza barra finale.
SITO_URL=
# Due segreti lunghi a caso (es. 40 caratteri): firma dei link e gettone di amministrazione.
AIRENDER_FIRMA=
AIRENDER_ADMIN_TOKEN=
